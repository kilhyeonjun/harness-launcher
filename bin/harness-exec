#!/usr/bin/env zsh
set -u

SCRIPT_DIR="$(cd "$(dirname "$0")" 2>/dev/null && pwd)"
if [[ ! -f "$SCRIPT_DIR/aliases.zsh" && -f "$SCRIPT_DIR/../share/harness-launcher/aliases.zsh" ]]; then
  SCRIPT_DIR="$(cd "$SCRIPT_DIR/../share/harness-launcher" 2>/dev/null && pwd)"
fi

usage() {
  cat <<'EOF'
Usage: harness-exec <harness-dir> [--cwd <dir>] [launcher arguments...]

Runs a registered harness without depending on interactive shell startup.
The current directory is used automatically when it resolves inside the harness;
otherwise the harness root remains the default. An explicit --cwd must resolve
inside that harness. A leading --isolated or --isolated-session <uuid> defaults
to the isolated session root instead of the current directory.
EOF
}

case "${1:-}" in
  -h|--help)
    usage
    exit 0
    ;;
esac

[[ $# -ge 1 ]] || { usage >&2; exit 2; }
HARNESS_DIR="$1"
shift
[[ -d "$HARNESS_DIR" && -f "$HARNESS_DIR/config/launcher.env" ]] || {
  echo "harness-exec: invalid harness directory: $HARNESS_DIR" >&2
  exit 2
}
HARNESS_DIR="${HARNESS_DIR:A}"

# Explicit legacy agents must be refused before OMP dispatch/probes as well.
source "$SCRIPT_DIR/harness-common.sh"
legacy_i=1
legacy_cwd="$HARNESS_DIR"
if [[ "${1:-}" == --cwd ]]; then
  [[ $# -ge 2 ]] || { echo 'harness-exec: --cwd requires a directory' >&2; exit 2; }
  legacy_cwd="$(harness_resolve_run_dir "$HARNESS_DIR" "$2")" || exit $?
  legacy_i=3
elif harness_resolve_run_dir "$HARNESS_DIR" "$PWD" >/dev/null 2>&1; then
  legacy_cwd="${PWD:A}"
fi
if [[ "${@[legacy_i]-}" == --no-isolated && -n "${@[legacy_i+1]-}" ]]; then
  case "${@[legacy_i+1]}" in
    kiro|kiro-cli|codex-gateway|checkup|codex-smoke|claude-management) ;;
    *) legacy_runtime=claude
       legacy_args=("${@[legacy_i+1,-1]}")
       if [[ "${legacy_args[1]}" == (omp|codex|claude) ]]; then
         legacy_runtime="${legacy_args[1]}"
         legacy_args=("${legacy_args[@]:1}")
       fi
       if ! harness_agent_is_management "$legacy_runtime" "${legacy_args[@]}"; then
         harness_canonical_agent_refuse "$legacy_cwd" "$legacy_runtime" || exit $?
       fi ;;
  esac
fi

# OMP executes the selected immutable closure, not the Homebrew spelling.
# Enrolled bare menus need that same consumer before workspace allocation.
# Argument exhaustion is distinct from a literal empty prompt/value.
local_omp_selector=1
case "${1:-}" in
  --cwd) local_omp_selector=3 ;;
esac
case "${@[local_omp_selector]-}" in
  --isolated|--no-isolated) (( local_omp_selector += 1 )) ;;
  --isolated-session) (( local_omp_selector += 2 )) ;;
esac
if [[ "${@[local_omp_selector]-}" == omp ]] || {
  (( local_omp_selector == $# + 1 )) &&
    [[ -e "$HOME/.config/harness-launcher/omp-projection-v1/enrollment.json" ]]
}; then
  source "$SCRIPT_DIR/harness-common.sh"
  omp_bootstrap_python="$(harness_python3_resolve)" || exit $?
  omp_dispatch_bin="$("$omp_bootstrap_python" -I -S -B \
    "$SCRIPT_DIR/harness_omp_projection.py" dispatch-source)" || exit $?
  if [[ "${@[local_omp_selector]-}" == omp ]]; then
    "$omp_bootstrap_python" -I -S -B "$SCRIPT_DIR/harness_omp_projection.py" \
      model-mode-early "$HARNESS_DIR" "$omp_dispatch_bin" "${@[local_omp_selector+1,-1]}"
    omp_mode_rc=$?
    (( omp_mode_rc == 0 )) || exit "$omp_mode_rc"
  fi
  if [[ "$SCRIPT_DIR" != "$omp_dispatch_bin" ]]; then
    exec /bin/zsh "$omp_dispatch_bin/harness-exec" "$HARNESS_DIR" "$@"
  fi
fi

source "$SCRIPT_DIR/aliases.zsh"

# Both isolated controls default to their session root; injecting the caller's
# directory would run in the canonical checkout and fail the TUI's boundary check.
# A continuation resume (herdr's bare `omp --session-resume <h> --`) runs in
# its recorded workspace; a caller directory would only be refused.
omp_resume=false
if [[ "${1:-}" == omp ]]; then
  for omp_arg in "${@:2}"; do
    [[ "$omp_arg" == -- ]] && break
    [[ "$omp_arg" == --session-resume ]] && { omp_resume=true; break; }
  done
fi
$omp_resume || case "${1:-}" in
  --cwd|--isolated|--isolated-session) ;;
  *)
    if HARNESS_CURRENT_DIR="$(harness_resolve_run_dir "$HARNESS_DIR" "$PWD" 2>/dev/null)"; then
      set -- --cwd "$HARNESS_CURRENT_DIR" "$@"
    else
      set -- --cwd "$HARNESS_DIR" "$@"
    fi
    ;;
esac

_harness_launcher_run "$HARNESS_DIR" "$@"
