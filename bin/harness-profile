#!/usr/bin/env zsh
set -u

INVOKED_NAME="${0:t}"
ENTRY_PATH="${0:a}"
SELF_PATH="${0:A}"
SCRIPT_DIR="${SELF_PATH:h}"
PROFILE_HOME="${HARNESS_PROFILE_HOME:-${XDG_CONFIG_HOME:-$HOME/.config}/harness-launcher}"
PROFILE_DIR="$PROFILE_HOME/profiles"
PROFILE_BIN_DIR="${HARNESS_PROFILE_BIN_DIR:-$HOME/.local/bin}"

usage() {
  cat <<'EOF'
Usage:
  harness-profile register <harness-dir>
  harness-profile <profile> [launcher arguments...]
  harness-profile checkup prompt-audit (--all | <profile>...) [--mode <preset>] [--max-budget-usd N]
  harness-profile target add <name> --from <targets.yaml>
  harness-profile target list
  harness-profile target show <name>
  <profile> [launcher arguments...]  # through a registered symlink

Registered profile commands use the current directory when it resolves inside
that harness. Otherwise they preserve the legacy harness-root default.
`checkup` runs `<profile> checkup prompt-audit` for each selected profile, one
at a time, and prints only each run's status line. The budget applies to each
run, so N profiles can spend N times the budget.
EOF
}

valid_prefix() {
  [[ "$1" =~ '^[A-Za-z_][A-Za-z0-9_-]*$' ]]
}

# profile_harness_dir <profile>: print the registered harness directory.
profile_harness_dir() {
  local profile="$1"
  valid_prefix "$profile" || {
    echo "harness-profile: invalid profile name: $profile" >&2
    return 2
  }
  local profile_file="$PROFILE_DIR/$profile"
  [[ -f "$profile_file" && ! -L "$profile_file" ]] || {
    echo "harness-profile: profile is not registered: $profile" >&2
    return 2
  }
  local harness_dir
  IFS= read -r harness_dir < "$profile_file"
  [[ -d "$harness_dir" && -f "$harness_dir/config/launcher.env" ]] || {
    echo "harness-profile: registered harness is unavailable: $harness_dir" >&2
    return 2
  }
  print -r -- "$harness_dir"
}

run_profile() {
  local profile="$1"; shift
  local harness_dir
  harness_dir="$(profile_harness_dir "$profile")" || return $?
  exec "$SCRIPT_DIR/harness-exec" "$harness_dir" "$@"
}

# run_checkup prompt-audit (--all | <profile>...) [--mode <preset>] [--max-budget-usd N]
#   Validates every selected profile before starting any run, then runs them
#   sequentially as separate launcher processes so each report stays in its
#   own harness.
run_checkup() {
  local usage="usage: harness-profile checkup prompt-audit (--all | <profile>...) [--mode <preset>] [--max-budget-usd N]"
  [[ "${1:-}" == prompt-audit ]] || { echo "harness-profile: $usage" >&2; return 2; }
  shift
  local all=false mode="" budget=""
  local -aU names=()
  local -a forward=()
  while (( $# )); do
    case "$1" in
      --all) all=true; shift ;;
      --mode)
        [[ $# -ge 2 ]] || { echo "harness-profile: --mode requires a preset" >&2; return 2; }
        [[ "$2" == (fast|base|opus|rich|fable) ]] || { echo "harness-profile: unsupported checkup preset: $2" >&2; return 2; }
        [[ -z "$mode" ]] || { echo "harness-profile: --mode accepts one preset" >&2; return 2; }
        mode="$2"; shift 2 ;;
      --max-budget-usd|--max-budget-usd=*)
        if [[ "$1" == *=* ]]; then budget="${1#*=}"; shift; else budget="${2-}"; shift $(( $# >= 2 ? 2 : 1 )); fi
        [[ "$budget" =~ '^[0-9]+(\.[0-9]+)?$' ]] && (( budget > 0 )) || {
          echo "harness-profile: --max-budget-usd requires a positive number" >&2
          return 2
        }
        ;;
      -*) echo "harness-profile: checkup does not accept '$1'; $usage" >&2; return 2 ;;
      *) names+=("$1"); shift ;;
    esac
  done
  if $all; then
    (( ${#names} == 0 )) || { echo "harness-profile: use --all or profile names, not both" >&2; return 2; }
    local entry
    for entry in "$PROFILE_DIR"/*(N.); do names+=("${entry:t}"); done
  fi
  (( ${#names} )) || { echo "harness-profile: no profiles selected; $usage" >&2; return 2; }
  [[ -n "$mode" ]] && forward+=("$mode")
  [[ -n "$budget" ]] && forward+=(--max-budget-usd "$budget")

  local -a dirs=()
  local name dir
  for name in "${names[@]}"; do
    dir="$(profile_harness_dir "$name")" || return $?
    dirs+=("$dir")
  done

  local ok=0 failed=0 i
  for (( i = 1; i <= ${#names}; i++ )); do
    print -u2 -r -- "== ${names[i]} =="
    if "$SCRIPT_DIR/harness-exec" "${dirs[i]}" checkup prompt-audit "${forward[@]}"; then
      ok=$(( ok + 1 ))
    else
      failed=$(( failed + 1 ))
    fi
  done
  print -r -- "checkup prompt-audit: $ok ok, $failed failed"
  (( failed == 0 ))
}

register_profile() {
  [[ $# -eq 1 ]] || { usage >&2; return 2; }
  local harness_dir="$1"
  [[ -d "$harness_dir" && -f "$harness_dir/config/launcher.env" ]] || {
    echo "harness-profile: invalid harness directory: $harness_dir" >&2
    return 2
  }
  harness_dir="${harness_dir:A}"

  local HARNESS_NAME="" HARNESS_PREFIX=""
  source "$harness_dir/config/launcher.env"
  valid_prefix "$HARNESS_PREFIX" || {
    echo "harness-profile: invalid HARNESS_PREFIX: $HARNESS_PREFIX" >&2
    return 2
  }
  case "$HARNESS_PREFIX" in
    checkup|register|target)
      echo "harness-profile: HARNESS_PREFIX is reserved by harness-profile: $HARNESS_PREFIX" >&2
      return 2
      ;;
  esac

  local command_path="$PROFILE_BIN_DIR/$HARNESS_PREFIX"
  local profile_file="$PROFILE_DIR/$HARNESS_PREFIX"
  local had_command=0
  if [[ -e "$command_path" || -L "$command_path" ]]; then
    if [[ ! -L "$command_path" || "${command_path:A}" != "$SELF_PATH" ]]; then
      echo "harness-profile: command destination is not launcher-owned: $command_path" >&2
      return 2
    fi
    had_command=1
  fi

  mkdir -p "$PROFILE_DIR" "$PROFILE_BIN_DIR" || {
    echo "harness-profile: failed to prepare profile directories" >&2
    return 2
  }
  chmod 700 "$PROFILE_HOME" "$PROFILE_DIR" || {
    echo "harness-profile: failed to secure profile directories" >&2
    return 2
  }

  if [[ -e "$profile_file" || -L "$profile_file" ]]; then
    if [[ ! -f "$profile_file" || -L "$profile_file" ]]; then
      echo "harness-profile: profile destination is not launcher-owned: $profile_file" >&2
      return 2
    fi
    local registered_harness
    IFS= read -r registered_harness < "$profile_file"
    if [[ "$registered_harness" != "$harness_dir" ]]; then
      echo "harness-profile: profile prefix already belongs to another harness: $HARNESS_PREFIX" >&2
      return 2
    fi
  fi

  local tmp_file="$PROFILE_DIR/.${HARNESS_PREFIX}.tmp.$$"
  umask 077
  if ! printf '%s\n' "$harness_dir" > "$tmp_file"; then
    rm -f "$tmp_file"
    echo "harness-profile: failed to stage profile: $HARNESS_PREFIX" >&2
    return 2
  fi
  if ! ln -sfn "$ENTRY_PATH" "$command_path"; then
    rm -f "$tmp_file"
    echo "harness-profile: failed to install profile command: $command_path" >&2
    return 2
  fi
  if ! mv "$tmp_file" "$profile_file"; then
    rm -f "$tmp_file"
    (( had_command )) || rm -f "$command_path"
    echo "harness-profile: failed to persist profile: $HARNESS_PREFIX" >&2
    return 2
  fi
  print -r -- "Registered $HARNESS_PREFIX -> $harness_dir"
}

if [[ "$INVOKED_NAME" != "harness-profile" ]]; then
  run_profile "$INVOKED_NAME" "$@"
  exit $?
fi

case "${1:-}" in
  -h|--help|"") usage; exit 0 ;;
  register)
    shift
    register_profile "$@"
    ;;
  checkup)
    shift
    run_checkup "$@"
    ;;
  target)
    shift
    source "$SCRIPT_DIR/harness-common.sh"
    python_bin="$(harness_python3_resolve)" || exit $?
    exec "$python_bin" -I "$SCRIPT_DIR/harness_target.py" "$@"
    ;;
  *)
    profile="$1"
    shift
    run_profile "$profile" "$@"
    ;;
esac
