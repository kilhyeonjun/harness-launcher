#!/usr/bin/env zsh
set -u

SELF_PATH="${0:A}"
SCRIPT_DIR="${SELF_PATH:h}"
source "$SCRIPT_DIR/harness-common.sh"
python_bin="$(harness_python3_resolve)" || exit $?
# ${0:a} makes the path absolute without resolving symlinks, so the default
# <bin> is the directory the user invoked (for example the Homebrew bin dir).
export HARNESS_PASEO_INVOKED_AS="${0:a}"
exec "$python_bin" "$SCRIPT_DIR/harness_paseo.py" "$@"
